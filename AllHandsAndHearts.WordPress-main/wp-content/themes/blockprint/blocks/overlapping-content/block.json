{
	"$schema": "https:\/\/schemas.wp.org\/trunk\/block.json",
    "apiVersion": 2,
    "name": "acf/overlapping-content",
    "title": "Overlapping Content",
    "description": "A two-column layout with an overlapping image.",
    "category": "blockprint",
    "icon": "block-default",
    "keywords": [],
    "acf": {
        "mode": "preview",
        "renderTemplate": "block.php"
    },
    "supports": {
        "align": ["full"],
        "anchor": true,
        "color": {
            "background": false,
            "text": true
        },
        "spacing": {
            "margin": [ "top", "bottom" ]
        }
    },
    "attributes": {
        "align": {
            "type": "string",
            "default": "full"
        }
    }
}