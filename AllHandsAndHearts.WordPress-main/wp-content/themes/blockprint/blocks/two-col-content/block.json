{
	"$schema": "https:\/\/schemas.wp.org\/trunk\/block.json",
    "apiVersion": 2,
    "name": "acf/two-col-content",
    "title": "Two-Column Content",
    "description": "",
    "category": "blockprint",
    "icon": "columns",
    "keywords": ["2"],
    "acf": {
        "mode": "preview",
        "renderTemplate": "block.php"
    },
    "supports": {
        "align": ["full"],
        "anchor": true,
        "spacing": {
            "margin": [ "top", "bottom" ]
        },
        "color": {
            "background": true,
            "text": true
        }
    },
    "attributes": {
        "align": {
            "type": "string",
            "default": "full"
        }
    }
}